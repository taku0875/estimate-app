{
  "name": "tsumiki-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "TSUMIKI 見積依頼書ジェネレーター(Next.js フロントエンド)",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "release:patch": "npm version patch -m \"release: v%s\"",
    "release:minor": "npm version minor -m \"release: v%s\"",
    "release:major": "npm version major -m \"release: v%s\""
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
